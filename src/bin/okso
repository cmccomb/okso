#!/usr/bin/env bash
#
# Entrypoint script for the Okso AI assistant.
#
# Usage:
#   ./src/bin/okso [OPTIONS] -- "user query"
#
# Options:
#   -h, --help            Show help text.
#   -V, --version         Show version information.
#   -y, --yes, --no-confirm
#                         Approve all tool runs without prompting.
#   -v, --verbose [LEVEL] Stream progress events (1 progress, 2 trace, 3 trace+schemas).
#   -vv, -vvv             Shorthand for trace levels 2/3.
#   -q, --quiet           Final summary only (no progress events).
#   --progress            Alias for level 1 progress mode.
#   --trace[=1|0]         Alias for trace mode on/off.
#
# Environment:
#   LLAMA_BIN       llama.cpp binary (default: llama-completion).
#
# Dependencies:
#   - bash 3.2+
#   - Optional: llama.cpp binary available on PATH for real scoring.
#
# Exit codes:
#   0 on success, non-zero on argument or runtime errors.

set -euo pipefail

resolve_script_dir() {
	# Resolve the directory of the current script, handling symlinks.
	# Arguments:
	#  None.
	# Returns:
	#  The absolute path to the directory containing the script.
	local source_path source_dir
	source_path="${BASH_SOURCE[0]}"

	while [ -h "${source_path}" ]; do
		source_dir=$(cd -P -- "$(dirname -- "${source_path}")" && pwd)
		source_path=$(readlink "${source_path}")
		if [[ "${source_path}" != /* ]]; then
			source_path="${source_dir}/${source_path}"
		fi
	done

	cd -P -- "$(dirname -- "${source_path}")" && pwd
}

fast_path_cli_flags() {
	# Handles --help/--version without loading full runtime dependencies.
	# Arguments:
	#   $@ - raw CLI arguments
	local first_arg
	first_arg="${1:-}"

	case "${first_arg}" in
	-h | --help)
		render_cli_usage
		exit 0
		;;
	-V | --version)
		render_cli_version
		exit 0
		;;
	esac
}

SCRIPT_DIR=$(resolve_script_dir)
SRC_ROOT=$(cd "${SCRIPT_DIR}/.." && pwd)
LIB_DIR="${SRC_ROOT}/lib"
export OKSO_ENTRYPOINT="${OKSO_ENTRYPOINT:-./src/bin/okso}"
# shellcheck source=src/lib/cli/usage.sh
source "${LIB_DIR}/cli/usage.sh"

fast_path_cli_flags "$@"

# shellcheck source=src/lib/core/logging.sh
source "${LIB_DIR}/core/logging.sh"
# shellcheck source=src/lib/core/json_state.sh
source "${LIB_DIR}/core/json_state.sh"
# shellcheck source=src/lib/settings/config.sh
source "${LIB_DIR}/settings/config.sh"
# shellcheck source=src/lib/cli/cli.sh
source "${LIB_DIR}/cli/cli.sh"
# shellcheck source=src/lib/settings/runtime.sh
source "${LIB_DIR}/settings/runtime.sh"

load_runtime_modules() {
	# Lazily loads heavy planner/tool modules once per process.
	# Arguments:
	#   None.
	# Returns:
	#   None.
	if [[ "${OKSO_RUNTIME_MODULES_LOADED:-false}" == true ]]; then
		return 0
	fi

	# shellcheck source=src/lib/tool_runtime/index.sh
	source "${LIB_DIR}/tool_runtime/index.sh"
	# shellcheck source=src/lib/planning/planner.sh
	source "${LIB_DIR}/planning/planner.sh"
	OKSO_RUNTIME_MODULES_LOADED=true
}

main() {
	# Main entrypoint for the okso assistant.
	# Arguments:
	#   Command-line arguments passed to the script.
	# Returns:
	#   Exit code 0 on success, non-zero on failure.

	local settings_prefix
	local plan_outline required_tools plan_entries plan_action plan_response plan_feedback
	local feedback_context_in_env previous_feedback_context
	local plan_start_time plan_duration plan_summary_body plan_iteration
	local search_context search_start_time search_duration
	local intent_json planner_tools intent_start_time intent_duration intent_context
	local intent_label intent_reason plan_tools_one_line
	local missing_final_answer_replanned
	local user_query

	# Initialize runtime settings and environment.
	settings_prefix="settings"
	load_runtime_settings "${settings_prefix}" "$@"
	if [[ "$(json_state_get_key "${settings_prefix}" "command")" == "init" ]]; then
		# Init mode writes a config file and exits without running the planner.
		apply_settings_to_globals "${settings_prefix}"
		write_config_file
		return 0
	fi
	load_runtime_modules
	prepare_environment_with_settings "${settings_prefix}"
	initialize_planner_models
	user_query="$(json_state_get_key "${settings_prefix}" "user_query")"
	OKSO_UI_RUN_STARTED_AT="$(date +%s)"
	export OKSO_UI_RUN_STARTED_AT
	export OKSO_JSON_LOGS="${OKSO_JSON_LOGS:-false}"

	# Recognize user intent.
	ui_status "${user_query}" "intent" "$(ui_elapsed_since_start)"
	intent_start_time="$(date +%s)"
	intent_json="$(recognize_intent "${user_query}")"
	log "INFO" "Recognized intent" "${intent_json}"
	planner_tools="$(intent_to_tools "${intent_json}")"
	log "INFO" "Intent tool filter" "$(printf '%s\n' "${planner_tools}" | paste -sd ',' -)"
	intent_context="$(render_intent_log_summary "${intent_json}" "${planner_tools}")"
	intent_duration="$(format_duration_from "${intent_start_time}")"
	intent_label="$(jq -r '.intents[0] // .intent // "general"' <<<"${intent_json}" 2>/dev/null || printf 'general')"
	intent_reason="$(jq -r '.rationale // ""' <<<"${intent_json}" 2>/dev/null || printf '')"
	if [[ -n "${intent_reason}" ]]; then
		ui_event "intent" "${intent_label} (${intent_reason})"
	else
		ui_event "intent" "${intent_label}"
	fi
	render_step_box "Intent" "${intent_duration}" "${intent_context}"

	# Fetch search context.
	ui_status "${user_query}" "search" "$(ui_elapsed_since_start)"
	search_start_time="$(date +%s)"
	search_context="$(planner_fetch_search_context "${user_query}" "${intent_json}")"
	search_duration="$(format_duration_from "${search_start_time}")"
	render_step_box "Search Context" "${search_duration}" "${search_context}"
	# Planner flow:
	# 1. Generate an outline, 2. identify tools, 3. build concrete plan entries
	# for execution, then 4. render plan outputs before proceeding.
	feedback_context_in_env=false
	missing_final_answer_replanned=false
	if printenv PLANNER_FEEDBACK_CONTEXT >/dev/null 2>&1; then
		feedback_context_in_env=true
		previous_feedback_context="${PLANNER_FEEDBACK_CONTEXT}"
	fi

	plan_iteration=0
	while true; do
		plan_iteration=$((plan_iteration + 1))
		ui_status "${user_query}" "plan" "$(ui_elapsed_since_start)"
		ui_event "plan" "iteration ${plan_iteration}"
		plan_start_time="$(date +%s)"
		log "INFO" "Starting plan generation" "${user_query}"
		plan_response="$(generate_planner_response_with_context "${user_query}" "${search_context}" "${planner_tools}" "${intent_json}")"
		plan_outline="$(plan_json_to_outline "${plan_response}")"
		required_tools="$(derive_allowed_tools_from_plan "${plan_response}")"
		log "INFO" "Planner identified tools" "${required_tools}"
		plan_entries="$(plan_json_to_entries "${plan_response}")"
		plan_duration="$(format_duration_from "${plan_start_time}")"
		plan_summary_body="$(format_plan_summary "${plan_outline}" "${required_tools}" "${plan_entries}")"
		plan_tools_one_line="$(printf '%s\n' "${required_tools}" | sed '/^[[:space:]]*$/d' | paste -sd ',' - | sed 's/,/, /g')"
		if [[ -n "${plan_tools_one_line}" ]]; then
			ui_event "plan" "tools: ${plan_tools_one_line}"
		fi

		render_step_box "Plan Iteration ${plan_iteration}" "${plan_duration}" "${plan_summary_body}"
		ui_trace_block "plan outline (iteration ${plan_iteration})" "${plan_outline}"
		if ui_trace_verbose_enabled; then
			ui_trace_block "planner response (iteration ${plan_iteration})" "$(jq '.' <<<"${plan_response}" 2>/dev/null || printf '%s' "${plan_response}")"
			ui_trace_block "tool schemas" "$(format_tool_descriptions "${required_tools}" "format_tool_line")"
		fi

		if ! jq -e 'type == "array" and any(.[]; .tool == "final_answer")' <<<"${plan_entries}" >/dev/null 2>&1; then
			if [[ "${missing_final_answer_replanned}" == false ]]; then
				ui_event "warn" "planner missing final_answer -> replanning once"
				PLANNER_FEEDBACK_CONTEXT="Plan must include a final_answer tool action."
				export PLANNER_FEEDBACK_CONTEXT
				missing_final_answer_replanned=true
				continue
			fi
			ui_event "warn" "planner still missing final_answer -> appending fallback"
			plan_entries="$(jq -c '. + [{tool:"final_answer", thought:"Provide a concise direct response.", args:{input:"I was unable to complete all planned steps, but here is the best available answer."}}]' <<<"${plan_entries}" 2>/dev/null || printf '%s' "${plan_entries}")"
		fi

		render_plan_outputs plan_action "${settings_prefix}" "${required_tools}" "${plan_entries}" "${plan_outline}" "${plan_response}"
		if [[ "${plan_action}" == "exit" ]]; then
			break
		fi

		if plan_feedback="$(request_plan_approval "${plan_outline}" "${required_tools}" "${plan_entries}")"; then
			break
		fi

		log "INFO" "Plan not approved; regenerating" "${plan_feedback}"
		ui_event "warn" "plan not approved -> replanning"
		PLANNER_FEEDBACK_CONTEXT="${plan_feedback:-Plan was not approved.}"
		export PLANNER_FEEDBACK_CONTEXT
	done

	if [[ "${plan_action}" == "exit" ]]; then
		return 0
	fi

	if [[ "${feedback_context_in_env}" == true ]]; then
		PLANNER_FEEDBACK_CONTEXT="${previous_feedback_context}"
		export PLANNER_FEEDBACK_CONTEXT
	else
		unset PLANNER_FEEDBACK_CONTEXT
	fi

	ui_status "${user_query}" "execute" "$(ui_elapsed_since_start)"
	select_response_strategy "${settings_prefix}" "${required_tools}" "${plan_entries}" "${plan_outline}" "${plan_response}"
}

main "$@"
